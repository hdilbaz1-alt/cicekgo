# ÇiçekGo sunucu .env şablonu — GERÇEK değerleri yalnız sunucudaki /opt/cicekgo/.env içine yaz (git'e ekleme!).

# Frontend build (statik export'a gömülür)
NEXT_PUBLIC_API_BASE_URL=https://customer-backend.cicekgo.net

# CORS (backend) — frontend domaini
CORS_ORIGIN=https://cicekgo.net

# PostgreSQL (host'ta; container'lar host.docker.internal ile bağlanır)
DB_MASTER_CONNECTION=Host=host.docker.internal;Port=5432;Database=cicekgo_master;Username=hazardilbaz0719;Password=CHANGE_ME
DB_TENANT_TEMPLATE=Host=host.docker.internal;Port=5432;Database={DBNAME};Username=hazardilbaz0719;Password=CHANGE_ME
DB_TENANT_PREFIX=cicekgo_tenant_

# JWT (min 32 karakter güçlü anahtar üret)
JWT_KEY=CHANGE_ME_super_secret_min_32_bytes_long
JWT_ISSUER=cicekgo
JWT_AUDIENCE=cicekgo
JWT_EXPIRES_MIN=480

# İlk açılışta platform admin (yoksa) seed edilir
SEED_ADMIN_USER=superadmin
SEED_ADMIN_PASS=CHANGE_ME
SEED_ADMIN_EMAIL=admin@cicekgo.net
