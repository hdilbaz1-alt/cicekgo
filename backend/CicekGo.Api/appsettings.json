{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "MasterConnection": "Host=localhost;Port=5432;Database=cicekgo_master;Username=postgres;Password=postgres",
    "TenantConnectionTemplate": "Host=localhost;Port=5432;Database={DBNAME};Username=postgres;Password=postgres",
    "TenantDbPrefix": "cicekgo_tenant_"
  },

  "Jwt": {
    "Key": "DEV_ONLY_CHANGE_ME_super_secret_key_min_32_bytes_long_123456",
    "Issuer": "cicekgo",
    "Audience": "cicekgo",
    "ExpiresMinutes": 480
  },

  "Seed": {
    "PlatformAdminUsername": "superadmin",
    "PlatformAdminPassword": "ChangeMe!123",
    "PlatformAdminEmail": "admin@cicekgo.local"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
